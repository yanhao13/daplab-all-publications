      // method/motivation figure lives). Excludes titlebar QR tiles — which
      // are also `<figure>` elements but must keep their fixed CSS size; the
      // measure pass below sets `img.style.width = '1px'` inline, which would
      // otherwise collapse the QRs to ~48px (an inline style beats any CSS).
      if (img.complete && img.naturalWidth) fit(img);
      else img.addEventListener('load', () => relayout(), { once: true });
