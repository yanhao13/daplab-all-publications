  // natural aspect ratio to the aspect of the slot it would get if STACKED.
  // Crucially, the stacked slot's height is the figure's true vertical BUDGET
  // -- the column height left after the Method bullets and every sibling card
  // -- NOT the `.method-figure { max-height }` cap (measuring the capped box
  // is circular: the cap makes the slot look short-and-wide, which wrongly
  // flips even landscape figures into the side-by-side row). We compute the
  // budget from the column's content height minus the bullets and siblings,
  // using scrollHeight so a flex-grown sibling doesn't inflate the figure (no)
  // budget. Defaults to stacked on a tie; 5% margin damps flip-flop. Safe to
  // call on non-Method figures (no .method-body -> no-op).
  function orientMethod(img) {
    const body = img.closest('.method-body');
    if (!body || !img.naturalWidth || !img.naturalHeight) return;
    body.classList.remove('method-horizontal');
    const fig = img.closest('figure');
    if (fig) { fig.style.maxWidth = ''; fig.style.maxHeight = ''; fig.style.width = ''; fig.style.height = ''; fig.style.flex = ''; }
    img.style.width = ''; img.style.height = ''; img.style.flex = '';
    const section = body.closest('.section');
    const col = section ? section.closest('.col') : null;
    const ul = body.querySelector('ul');
    const cap = fig ? fig.querySelector('figcaption') : null;
    // Slot width: the figure box's current width == column content width.
    const availW = (fig ? fig.getBoundingClientRect() : body.getBoundingClientRect()).width;
    // Slot height budget: column content height minus the Method header +
    // bullets and every OTHER section's natural (scroll) height, minus the
    // caption. scrollHeight ignores flex-grow stretching so a .grow sibling
    // doesn't steal the figure's budget on paper.
    let budget = 0;
    if (col && section) {
      const colH = col.clientHeight;
      let used = 0;
      col.querySelectorAll(':scope > .section').forEach(s => {
        used += (s === section) ? 0 : s.scrollHeight;
      });
      const h2 = section.querySelector('h2');
      const headH = h2 ? h2.scrollHeight : 0;
      const ulH = ul ? ul.scrollHeight : 0;
      const capH = cap ? cap.scrollHeight : 0;
      budget = colH - used - headH - ulH - capH - 24; // gaps + slack
    }
    if (availW <= 0 || budget <= 0) return;  // unmeasurable -> leave stacked
    const arFig = img.naturalWidth / img.naturalHeight;
    const arSlot = availW / budget;
    // Bullet-width floor: the horizontal layout hands the bullets ~42% of the
    // row (see `.method-horizontal > ul { flex: 0 1 42% }`). If that share would
    // be narrower than a readable measure, the text wraps into a tall 2–3-word
    // ribbon that looks worse than just stacking. MIN_BULLET_W mirrors the CSS
    // `min-width: 22em` floor, resolved to px against the body's font-size so it
    // tracks the poster's cqw-scaled type. We veto the flip when 42% of the row
    // (gap removed) can't clear it -- a stacked full-width figure with bullets
    // above always out-reads starved side-by-side text.
    const emPx = parseFloat(getComputedStyle(body).fontSize) || 16;
    const MIN_BULLET_W = 22 * emPx;
    const GAP = 32; // ~24pt row gap in px
    const bulletShareW = (availW - GAP) * 0.42;
    const bulletsFit = bulletShareW >= MIN_BULLET_W;
    // Three conditions ALL required to go horizontal:
    //   (1) arFig < 1 -- the figure is genuinely PORTRAIT. A landscape figure
    //       (arFig >= 1) always stacks: side-by-side can't help it (it would
    //       still fill on width, ~58% instead of ~100%, and leave a tall void
    //       under it when the bullets wrap taller than the figure). The guard
    //       stops a wide-short stacked slot (large arSlot from a crowded
    //       column) from dragging a landscape figure into the row by accident.
    //   (2) arFig < arSlot -- the figure is narrower/taller than its stacked
    //       slot, so stacking would leave side gutters that the row reclaims.
    //   (3) bulletsFit -- the 42% bullet share clears the readable-width floor.
    //       Without this a narrow column (or a Tier-5 width nudge that shrinks
    //       the Method column) would flip and starve the text.
    body.classList.toggle('method-horizontal', arFig < 1 && arFig < arSlot * 0.95 && bulletsFit);
  }
  // `fit()` / `orientMethod()` read geometry via getBoundingClientRect(), which an ancestor
  // `transform: scale()` would distort. So every relayout runs in the UNSCALED
  // state: the #poster-stage controller clears its transform, we fit figures at
  // true 1:1 size, then it re-applies the scale. __fitPosterStage() is defined
  // by the controller IIFE at the end of <body>; if it hasn't registered yet
  // (first synchronous call), just fit directly.
  function relayout() {
    if (window.__fitPosterStage) window.__fitPosterStage(fitAll);
    else fitAll();
  }
  if (document.readyState === 'complete') relayout();
  else window.addEventListener('load', relayout);
  let raf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(relayout);
  });
})();
</script>
<script>
// #poster-stage controller: scale the WHOLE poster (box + content together)
// to fit the window, in both normal and fullscreen view. This is what makes
// the on-screen preview match the printed PDF at any window size.
//
// The poster lays out at its true fixed canvas (5760x3456px = 60x36in @96ppi).
// We compute scale = min(winW/5760, winH/3456) and apply `transform: scale()`
// to .poster, sizing #poster-stage to the scaled footprint so the page centers
// with no scrollbars. Because the transform scales the rendered element, fonts,
// padding, figures — everything — shrink as one locked unit; no reflow, so the
// layout stays pixel-identical to the PDF.
//
// Print-safe by construction: under Chromium print emulation the viewport IS
// 5760x3456, so scale === 1 (identity). render_poster.py / check_poster.py see
// the untransformed canvas and the PDF/PNG export is byte-for-byte unchanged.
// render_poster.py's own 0.35x thumbnail transform is applied AFTER this (no
// resize event fires to clobber it), so the PNG is unaffected too.
(function () {
  const CANVAS_W = 4494, CANVAS_H = 3178;  // 60x36in at 96ppi
  const stage  = document.getElementById('poster-stage');
  const poster = stage && stage.querySelector('.poster');
  if (!stage || !poster) return;

  let applying = false;
  // Apply the fit. Optional `beforeScale` callback runs while the poster is
  // UNSCALED (transform cleared) — figure-fitting needs true geometry. We then
  // re-apply the scale. The `applying` guard stops the resize listener from
  // re-entering when beforeScale itself triggers a synchronous reflow.
  function apply(beforeScale) {
    if (applying) return;
    applying = true;
    try {
      poster.style.transform = 'none';
      if (typeof beforeScale === 'function') beforeScale();
      const scale = Math.min(
        window.innerWidth  / CANVAS_W,
        window.innerHeight / CANVAS_H,
      );
      poster.style.transform = 'scale(' + scale + ')';
      stage.style.width  = (CANVAS_W * scale) + 'px';
      stage.style.height = (CANVAS_H * scale) + 'px';
    } finally {
      applying = false;
    }
  }
  // Exposed so the figure-fit IIFE and the fullscreen handler drive a single
  // code path. They pass their fitAll() as `beforeScale` so figures are sized
  // unscaled, then the poster is re-scaled in one shot.
  window.__fitPosterStage = apply;

  apply();
  let raf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => apply());
  });
})();
</script>
