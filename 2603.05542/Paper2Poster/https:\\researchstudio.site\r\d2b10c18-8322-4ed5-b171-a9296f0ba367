    // the figure's aspect ratio to the aspect of the slot it would occupy if
    // stacked (column width vs the vertical room flexbox hands the figure):
    //   w_fig/h_fig  >  w_slot/h_slot  -> figure is wider than its stacked
    //       slot, fills the slot's WIDTH -> keep the vertical STACK (bullets
    //       above, full-width figure below).
    //   w_fig/h_fig  <  w_slot/h_slot  -> figure is taller than its stacked
    //       slot, would paint narrow with side gutters -> flip to a side-by-
    //       side ROW (.method-horizontal: bullets ~42%, figure ~58% at full
    //       row height) so the tall figure gets a taller, better-matched slot.
    // This is now policy-consistent: under the width-OR-height fill rule, a
    // tall figure beside text fills the row HEIGHT to ~100%, which the rule
    // accepts. orientMethod() makes the call; fit() then sizes the figure
    // within whichever orientation was chosen.
    document.querySelectorAll('.method-body').forEach(body => {
      const img = body.querySelector('figure img');
      if (img && img.complete && img.naturalWidth) orientMethod(img);
      else body.classList.remove('method-horizontal');  // stacked until image loads
