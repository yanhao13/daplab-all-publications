    .dbg-bbox-elem.dbg-slack {
      border: calc(3pt * var(--dbg-scale,1)) solid rgba(232,120,0,0.98);
      --de-fill: rgba(255,178,38,0.13); background: var(--de-fill);
      box-shadow: 0 0 calc(11pt * var(--dbg-scale,1)) rgba(232,120,0,0.5),
                  inset 0 0 0 1px rgba(255,255,255,0.3); z-index: 63; }
    .dbg-bbox-elem.dbg-slack .dbg-elem-label { background: rgba(232,120,0,0.98); }
    .dbg-slack-pill {
      position: absolute; right: calc(2pt * var(--dbg-scale,1)); bottom: calc(2pt * var(--dbg-scale,1));
      font-family: ui-monospace, monospace; font-size: calc(5.4pt * var(--dbg-scale,1)); font-weight: 900;
      padding: calc(1.5pt * var(--dbg-scale,1)) calc(4.5pt * var(--dbg-scale,1));
      background: rgba(232,120,0,0.98); color: #fff; border-radius: 99pt;
      box-shadow: 0 calc(1pt * var(--dbg-scale,1)) calc(4pt * var(--dbg-scale,1)) rgba(0,0,0,0.32);
      white-space: nowrap; z-index: 64; letter-spacing: .03em; }
    body:not(.debug) .dbg-bbox-elem, body:not(.debug) .dbg-slack-pill { display: none; }
  `;
  document.head.appendChild(S);

  function stampElements() {
    const poster = document.querySelector(".poster");
    if (!poster) return;
    poster.querySelectorAll(".dbg-bbox-elem").forEach(n => n.remove());
    const pr = poster.getBoundingClientRect();
    const s  = poster.offsetWidth ? pr.width / poster.offsetWidth : 1;
    const toLocal = r => ({ x: (r.left - pr.left) / s, y: (r.top - pr.top) / s,
                            w: r.width / s, h: r.height / s });
    document.querySelectorAll(".section[data-section]").forEach(sec => {
      const kids = Array.from(sec.children).filter(k => k.classList
        && !k.classList.contains("listen-btn") && !k.classList.contains("dbg-badge")
        && !k.classList.contains("dbg-bbox") && !k.classList.contains("dbg-bbox-elem"));
      const boxes = kids.map(k => ({
        tag: k.tagName.toLowerCase(), box: toLocal(k.getBoundingClientRect()),
        isFig: (k.tagName === "FIGURE" || !!k.querySelector("figure")),
      })).filter(b => b.box.w > 1 && b.box.h > 1);
      boxes.sort((a, b) => a.box.y - b.box.y);
      const padB = parseFloat(getComputedStyle(sec).paddingBottom) || 0;
      const sL = toLocal(sec.getBoundingClientRect());
      const cardBottom = sL.y + sL.h - padB;
      let maxGap = -1, maxIdx = -1;
      boxes.forEach((b, i) => {
        const bot = b.box.y + b.box.h;
        b.gap = Math.max(0, (i + 1 < boxes.length) ? boxes[i + 1].box.y - bot : cardBottom - bot);
        if (!["h1", "h2", "h3"].includes(b.tag) && b.gap > maxGap) { maxGap = b.gap; maxIdx = i; }
      });
      boxes.forEach((b, i) => {
        const isHead = ["h1", "h2", "h3"].includes(b.tag);
        const typeCls = b.isFig ? "de-fig" : isHead ? "de-head"
                       : (b.tag === "ul" || b.tag === "ol") ? "de-list" : "de-text";
        const d = document.createElement("div");
        d.className = "dbg-bbox dbg-bbox-elem " + typeCls + (i === maxIdx ? " dbg-slack" : "");
        d.style.left = b.box.x + "px"; d.style.top = b.box.y + "px";
        d.style.width = b.box.w + "px"; d.style.height = b.box.h + "px";
        const L = document.createElement("div");
        L.className = "dbg-elem-label";
        L.textContent = b.tag + "  ·  gap " + Math.round(b.gap) + "px";
        d.appendChild(L);
        if (i === maxIdx) {
          const pill = document.createElement("div");
          pill.className = "dbg-slack-pill";
          pill.textContent = b.isFig ? "SLACK ▸ ENLARGE FIGURE" : "SLACK ▸ GROW THIS";
          d.appendChild(pill);
        }
        poster.appendChild(d);
      });
    });
  }

  const orig = window.__togglePosterDebug;
  window.__togglePosterDebug = function () {
    if (orig) orig();
    if (document.body.classList.contains("debug")) setTimeout(stampElements, 40);
    else document.querySelectorAll(".dbg-bbox-elem").forEach(n => n.remove());
  };
})();
</script>
<script>
// Resize each <figure> so its inner <img> fills the figure box edge-to-edge

// (no letterboxing). See poster_full_template for the full rationale.
(function () {
  function fit(img) {
    /* paper2poster:frozen-geometry-fit-guard */
    if (document.documentElement.getAttribute('data-poster-geometry-frozen') === '1') return;
    const fig = img.closest('figure');
    if (!fig) return;
    const nw = img.naturalWidth, nh = img.naturalHeight;
    if (!nw || !nh) return;
    const cap = fig.querySelector('figcaption');
    const section = fig.closest('.section');
    // Collapse the figure to a sliver BEFORE measuring, so a grow section
    // (flex: 1 1 auto) settles to its stable flex-allocated height instead of
    // ballooning around the full-size image -- otherwise section.bottom is
    // circular and over-reports the budget, the image isn't shrunk enough, and
    // its caption overflows the figure box where `figure{overflow:hidden}`
    // clips it. Clearing alignSelf lets the collapsed figure stretch to the
    // section's full content width (not shrink-wrap to the caption), so availW
    // is the true available width. See poster_full_template for the full
    // rationale.
    img.style.width = '1px'; img.style.height = '1px'; img.style.flex = '0 0 auto';
    fig.style.maxWidth = ''; fig.style.maxHeight = '';
    // Reset the pinned width/height/flex too (see the fit() commit below).
    // The pin shrinks the figure box to the painted-image AR; if a leftover
    // pin from a previous pass survives this collapse step, the new
    // `figRect = fig.getBoundingClientRect()` reads the old pin (not the
    // true available width), and fit() locks the figure at the stale size
    // even after the column or method orientation changes.
    fig.style.width = ''; fig.style.height = ''; fig.style.flex = '';
    // Also clear a leftover `align-self: center` from a previous pass. With it
    // set (and no maxWidth), the collapsed figure shrink-wraps to its widest
    // child -- the caption -- instead of stretching to the section's full
    // content width, so availW reads ~caption-width (much narrower) and the
    // image is then sized into that too-small box: it paints narrow and trips
    // the FIG/NARROW polish check. Cleared, the figure stretches to its flex
    // cross-size (full column width when stacked, its row share when
    // side-by-side) -- the true available width.
    fig.style.alignSelf = '';
    const figRect = fig.getBoundingClientRect();
    const availW = figRect.width;
    let budgetH = figRect.height;
    if (section) {
      const scs = getComputedStyle(section);
      const sBottom = section.getBoundingClientRect().bottom
                    - (parseFloat(scs.paddingBottom) || 0)
                    - (parseFloat(scs.borderBottomWidth) || 0);
      budgetH = sBottom - figRect.top;
    }
    // Figure budget floor (generalized, applies to ALL section figures,
    // not just Method). When the figure's section doesn't carry `.grow`
    // (e.g., Key Result sitting below a tall table), the section's
    // auto-height collapses to siblings + caption during the measure pass,
    // so `sBottom - figRect.top` reports a near-zero budget. The figure
    // pin below then shrinks the image to a ~15x60px stripe whose
    // figcaption wraps to one-character-per-line. This bug was originally
    // method-only and is the general "fit() collapse-pass feedback loop"
    // (the very act of collapsing the figure to measure makes the section
    // shrink, which makes the budget tiny, which pins the figure tiny).
    //
    // Fix: HARD-floor the budget so the figure always fills >= FIG_MIN_RATIO
    // of its slot (width-fill height for non-Method, 24% canvas for Method).
    // We deliberately do NOT cap the floor by the column's remaining room: a
    // figure is immovable, so if it cannot fit it OVERFLOWS and the fill loop
    // resolves that by trimming text, never by shrinking the figure.
    //
    // .method-horizontal is exempt: the row layout already gives the
    // figure a tall slot beside the bullets, so the auto budget is correct
    // and the floor would push it past the row's height.
    const inMethod = fig.parentElement
                  && fig.parentElement.classList
                  && fig.parentElement.classList.contains('method-body');
    const inMethodRow = inMethod
                  && fig.parentElement.classList.contains('method-horizontal');
    if (!inMethodRow && section) {
      const poster = section.closest('.poster');
      const canvasH = poster ? poster.clientHeight : 3178;
      // Method gets a taller floor (24%) because it's the primary visual;
      // other figures (key-result, qualitative, motivation) get 15% which
      // is still well above the 70% width-fill threshold for typical AR
      // 3:1-5:1 figures.
      const FIG_MIN_RATIO = 0.90;
      // HARD floor: a figure never shrinks below FIG_MIN_RATIO fill on its
      // wider axis (width-fill height for non-Method; 24% canvas for Method).
      // NO column cap: a too-tight column OVERFLOWS instead, and the fill loop
      // resolves that by trimming text -- figures are immovable.
      let MIN_FIG_BUDGET = inMethod ? 0.24 * canvasH
                         : Math.min(0.9 * canvasH, FIG_MIN_RATIO * availW * nh / nw);
      if (budgetH < MIN_FIG_BUDGET) budgetH = MIN_FIG_BUDGET;
    }
    if (availW <= 0 || budgetH <= 0) return;
    const arImg = nw / nh;
    // Width-OR-height sizing: a figure should fill 80-100% of the section on
    // at least one axis -- either width OR the vertical room flexbox handed
    // it, not necessarily both. Plain AR-preserving contain fit: start
    // full-width; if too tall for the room, shrink to fit height instead.
    //
    // The figcaption's wrapped height depends on the figure's FINAL width: a
    // one-line caption at full column width wraps to two once the image is
    // pinned narrower (the usual case for a height-bound figure). So caption
    // room can't be reserved from a single up-front measurement -- doing so
    // under-reserves it and the second line bleeds past the figure box (which
    // `figure { overflow: visible }` allows, so the deep-walk content union
    // in slack reads it as SPILLAGE / OVERFLOW past the section bottom).
    //
    // We deliberately do NOT iterate `width <-> caption-height`: if we did,
    // a narrow w would force the caption to wrap into more lines, which ate
    // into availH, which shrank w further, which wrapped the caption taller
    // again -- a spiral that converged to a ~100px-wide stamp with a 6-line
    // caption. Instead: measure the caption ONCE at availW (the full slot
    // the figure box would get before AR-preserving narrowing), pin the
    // AR-preserving image, then RE-MEASURE the caption at the pinned width
    // to set the true figure box height. Final pinned figure's caption may
    // wrap to a few more lines if the image is much narrower than availW,
    // but the re-measure pass reserves that height honestly so the box
    // doesn't bleed.
    // capGap is the caption's top margin (its gap from the image); capH is
    // the caption's own box + bottom margin.
    const capGap = cap ? (parseFloat(getComputedStyle(cap).marginTop) || 0) : 0;
    let capH = 0;
    if (cap) {
      // Measure-pass: width = availW, image collapsed.
      img.style.width = '1px'; img.style.height = '1px'; img.style.flex = '0 0 auto';
      fig.style.maxWidth = availW + 'px'; fig.style.maxHeight = '';
      const cs = getComputedStyle(cap);
      capH = cap.getBoundingClientRect().height + (parseFloat(cs.marginBottom) || 0);
    }
    const availH = Math.max(1, budgetH - capH - capGap - 2);
    // AR-preserving contain fit: start at full width; if too tall, shrink to availH.
    let w = availW, h = w / arImg;
    if (h > availH) { h = availH; w = h * arImg; }
    // Tier-5 image-scale override: if the <img> has a `data-fill-scale`
    // attribute (e.g., `data-fill-scale="0.85"`), multiply the computed
    // size by that factor before pinning. Clamped to [0.8, 1.0] so the
    // image never grows past the natural fit (the figure box wouldn't
    // have room) and never shrinks below 80% (image becomes unreadable).
    const raw = parseFloat(img.getAttribute('data-fill-scale'));
    const scale = Number.isFinite(raw) ? Math.min(1.0, Math.max(0.8, raw)) : 1.0;
    w *= scale; h *= scale;
    // Wide-figure floor: when a horizontally-dominant figure (AR ≥ 2.5)
    // ends up below 70% of available width because flexbox squeezed its
    // section, a tiny stamp at the top of a huge card is a worse defect
    // than a slightly tight neighbour. Push width back up to the floor
    // and pin the section's min-height so flex respects the larger
    // footprint (sibling .grow/.mid-sub absorbs the difference).
    const FLOOR_RATIO = 0.75;
    const WIDE_AR     = 2.5;
    if (arImg >= WIDE_AR && availW > 0 && (w / availW) < FLOOR_RATIO) {
      w = FLOOR_RATIO * availW;
      h = w / arImg;
      if (section) {
        const sb = section.getBoundingClientRect();
        const figTopRel = figRect.top - sb.top;
        const scs = getComputedStyle(section);
        const padB = parseFloat(scs.paddingBottom) || 0;
        const needed = figTopRel + h + capH + capGap + padB + 4;
        const cur = parseFloat(section.style.minHeight) || 0;
        if (needed > cur) section.style.minHeight = needed + 'px';
      }
    }
    img.style.width  = w + 'px';
    img.style.height = h + 'px';
    img.style.flex   = '0 0 auto';
    // Pin the figure box to the AR-preserving width, then RE-MEASURE the
    // caption at that pinned width. The caption may wrap taller inside the
    // narrower box than it did at availW; without this re-measure the figure
    // box reserves too little height and the caption visibly bleeds past
    // the bottom border.
    fig.style.maxWidth  = w + 'px';
    fig.style.maxHeight = '';
    fig.style.width     = w + 'px';
    fig.style.height    = '';
    fig.style.flex      = '0 0 auto';
    let trueCapH = capH;
    if (cap) {
      const cs = getComputedStyle(cap);
      trueCapH = cap.getBoundingClientRect().height
               + (parseFloat(cs.marginBottom) || 0);
    }
    const figH = h + trueCapH + capGap + 2;
    fig.style.maxHeight = figH + 'px';
    fig.style.height    = figH + 'px';
    // (Width/height/flex pinning happened above with trueCapH; nothing left
    // to do here. Pinning matters because `figure { flex: 1 1 auto }` inside
    // a column-flex parent (.method-body or .section) lets the box stretch
    // wider than the AR-preserving slot, and `figure img { width:100%;
    // height:100%; max-height:100% }` then clamps the img height to the
    // stretched parent -- `object-fit: contain` paints a letterboxed image
    // that fills only ~50% of the figure card on both axes, tripping
    // FIG/NARROW in slack and polish.)
    // Center the shrunk figure inside its section. The section is a
    // `display: flex; flex-direction: column` parent that defaults to
    // `align-items: stretch`; a figure with an explicit `maxWidth` no
    // longer stretches, so flexbox falls back to the start edge (left)
    // unless we override per-item alignment.
