<!-- KaTeX for inline equations (thinner glyphs than MathJax; matches the
     posterskill look). The jsdelivr CDN URLs below are intercepted by the
     paper2poster renderer (scripts/utils/render.py + html2pptx) and fulfilled
     from the skill's bundled assets/katex/ mirror, so equations render
     deterministically offline (no CORS). CDN kept as transparent fallback when
     the page is opened outside the renderer with network access. The source TeX
     survives in each .katex's <annotation encoding="application/x-tex">, which
     html2pptx reads to rasterize/emit the equation (engine-agnostic math pass). -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
  onload="renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true},{left:'\\[',right:'\\]',display:true},{left:'$',right:'$',display:false},{left:'\\(',right:'\\)',display:false}],throwOnError:false});"></script>
<style>
  /* headline-hero math sizing — KaTeX equivalents of the MathJax mjx-container rules */
  .headline-hero .katex { max-width: 100% !important; }
  .headline-hero .katex-display { max-width: 100% !important; }
  .headline-hero .hero-val .katex { font-size: 46% !important; }
</style>


<style>
  /* Print canvas locked to ICML/NeurIPS standard 60×36 in landscape (5:3).
     `render_poster.py` reads this @page rule to size the exported PDF;
     the on-screen .poster element below uses aspect-ratio: 5/3 so the
     letterboxed browser view matches the printed page exactly. */
  /* Inter webfont — bundled with the skill assets and copied into the
     poster outdir by render_poster.py so the HTML is self-contained.
     Single source of truth so the rendered PDF, the HTML preview, and
     the converted .pptx all show the same glyphs (html2pptx embeds the
     same .ttf into the .pptx so reviewers don't need Inter installed).
     Four weights — Regular 400 / SemiBold 600 / Bold 700 / ExtraBold 800
     cover body, h2/strong, and h1 with no synthetic-bold fallback. */
  @font-face {
    font-family: 'Inter';
    font-style: normal; font-weight: 400; font-display: block;
    src: url('assets/fonts/Inter-Regular.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal; font-weight: 600; font-display: block;
    src: url('assets/fonts/Inter-SemiBold.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal; font-weight: 700; font-display: block;
    src: url('assets/fonts/Inter-Bold.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal; font-weight: 800; font-display: block;
    src: url('assets/fonts/Inter-ExtraBold.woff2') format('woff2');
  }

  @page { size: 46.8in 33.1in; margin: 0; }
  :root {
    --accent: #34373b;
  --accent-ink: #ffffff;
    --accent-soft: #eeeff1;
    /* LIGHT default header (user default): a pale tint of the theme hue instead of
       the deep saturated band, a dark same-hue title, and NO white chip behind the
       logos. framed/simple still override these with their own --tb-*. The deep
       --accent now survives only as h2/title text + thin rules — the dominant deep
       colour band (blue/red/green) is hidden. */
    --tb-bg: var(--accent-soft);
    --tb-fg: #1b2331;
    --tb-title-fg: var(--accent);
    --tb-conf-fg: var(--accent);
    --tb-sub-fg: #55617a;
    --tb-divider: rgba(20, 30, 50, 0.16);
    --tb-chip-bg: transparent;
    --tb-chip-shadow: none;
    --callout: #ae2622;
    /* Highlight ring for the section currently being narrated (audio playback).
       Defaults to the red callout, but a JS hook at the end of <body> overrides it
       to CONTRAST the VI theme accent — blue VI (#1d3a87) -> red ring, red VI
       (#ae2622) -> blue ring — so the "now playing" cue never blends into a
       same-hue poster frame and stays legible on either theme. */
    --play-highlight: var(--callout);
    --play-highlight-red: #ae2622;
    --play-highlight-blue: #34373b;
    --text: #1c1c1c;
    --muted: #555;
    --bg: #fafaf7;
    --border: 4px solid var(--accent);
    /* Single highlight color used by inline emphasis (<strong>, .hi, .num) across
       ALL sections. A strong near-black (#111) so highlighted words read
       as one consistent "look-here" signal everywhere on the poster. The per-section
       accent still differentiates the Listen button. */
    --highlight-accent: #111111;
    --highlight-soft: #ececec;
    /* OS-builtin font stack — split into Latin and CJK so the browser's
       per-glyph font fallback dispatches automatically (English chars hit
       the latin stack first; Chinese chars miss it and fall through to
       the cjk stack). Both halves picked so the rendered PDF / PPT needs
       ZERO font installation on any reviewer's machine.

       --font-latin policy: default ARIAL — cross-platform-safe, pre-installed on
       Mac + Windows PowerPoint, so the exported .pptx needs ZERO font embedding.
       Override by editing --font-latin below to any PPT-safe family:
         Arial (default) · Calibri · Aptos · Cambria · "Times New Roman" ·
         Verdana · Georgia · "Trebuchet MS"
       To use INTER instead (bundled webfont, more editorial): set --font-latin to
         Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, Arial
       AND run html2pptx's Inter embed (font_embedder.py) so the .pptx ships the
       font. The 4 Inter @font-face blocks above stay defined but inert (browsers
       lazy-load — an unused @font-face is never fetched), so the Inter override is
       a one-line flip.

       --font-cjk is fixed at Microsoft YaHei primary:
         - "Microsoft YaHei"  → Windows default CJK sans
         - "PingFang SC"                  → Mac default CJK sans
         - "Noto Sans CJK SC"             → Linux fallback (also widely available on Mac)
         If a poster has zero Chinese chars, --font-cjk is never consulted.

       Monospace stays as ui-monospace below — same OS-builtin rule. */
    --font-latin: Verdana, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-cjk: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC";
    --font-sans: var(--font-latin), var(--font-cjk), sans-serif;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
  }
  /* The poster's true physical canvas is 60in × 36in (`@page { size: 60in 36in }`
     above keeps PDF export aligned). On screen we FIT it to the browser window
     instead of showing it at literal CSS-inch size: `width: min(100vw, calc(100vh
     * 5 / 3))` makes the poster as wide as the window allows while never letting
     its 5:3 height exceed the window height — so the whole poster is visible with
     no scrolling, in BOTH normal and fullscreen view. Because every font/padding/
     gap inside is a `cqw`/`cqh` unit resolving against the poster's own box,
     scaling the box re-scales the whole layout proportionally — still 1:1 with the
     printed PDF. Under print emulation the viewport IS the canvas (60×36in at
     96ppi), so `min(100vw, …)` resolves to exactly 60in and the exported PDF/PNG
     are byte-for-byte unchanged. */
  .poster {
    /* Fixed physical canvas: 60x36in at 96ppi = 5760x3456px. The poster
       always lays out at this true size; the #poster-stage controller at the
       end of <body> scales the WHOLE element -- box AND content together --
       with one transform so it fits any window (normal or fullscreen) while
       staying pixel-identical to the printed PDF. Under print emulation the
       viewport IS 5760x3456, so the computed scale is exactly 1 (identity)
       and the PDF/PNG export is byte-for-byte unchanged. */
    width: 4494px;
    height: 3178px;
    overflow: hidden;
    border: var(--border);
    /* container-type: size makes every `cqw` unit below resolve against the poster's
       OWN width, not the viewport. Without this, `vw`-based clamps hit their max
       ceiling at wildly different fractions of the canvas in the browser preview
       (~1900px viewport → clamp at max) vs the print render (5760px viewport →
       clamp ceiling is 3× too small relative to the poster) — same HTML, two
       different-looking layouts. With cqw, fonts/paddings/gaps scale linearly
       with the poster element regardless of viewport. */
    container-type: size;
    padding: 52pt;
    display: flex;
    flex-direction: column;
    gap: 30pt;
    font-size: 32pt;
    line-height: 1.38;
  }
  /* #poster-stage wraps .poster and reserves its SCALED footprint so the page
     centers with no scrollbars. The controller IIFE at the end of <body> sets
     this element's width/height to (scale x canvas) and applies the matching
     `transform: scale()` to .poster, so the box AND its content scale together
     to fit the window — in both normal and fullscreen view. On screen the
     footprint equals the old `min(100vw, calc(100vh * 5/3))` box exactly; the
     only change is that the content now rides along. Under print emulation the
     viewport IS the 5760x3456 canvas, so scale resolves to 1 and the rendered
     PDF/PNG are byte-for-byte unchanged. */
  #poster-stage {
    position: relative;
    width: 4494px;
    height: 3178px;
    margin: 0 auto;
  }
  .poster {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
  }
  /* ---- Header (titlebar) ----
     The titlebar's HTML + CSS are now a swappable HEADER partial
     (assets/headers/<v>.html), injected at the HEADER hook in <body>
     by references/compose_poster.py. The partial ships its own <style>, so
     the old `.titlebar*` rules that lived here have moved out. The shared
     `.titlebar.playing` narration ring stays below with the section rules. */

  /* Columns row stretches to fill remaining height. Tune column ratios per content volume. */
  .columns {
    display: grid;
    grid-template-columns: 1.18fr 1.16fr 1.16fr 1.18fr;
    gap: 32pt;
    flex: 1 1 auto;
    min-height: 0;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 28pt;
    min-height: 0;
  }
  /* .mid-wide: a "merged middle" block that occupies grid columns 2-3 of the
     outer .columns grid. This is the core layout of poster_full_template.html
     for wide / full-width Method figures (AR ≥ 2.5 OR {column=full}) — the
     wide figure gets a full-width strip on top of the middle area, then
     Dataset and Key Result split into 2 sub-columns below. Outer cols 1 and 4
     keep their normal narrow width. This is the "row-merge" pattern documented
     in IDEAS.md #4 — 4-col stays the default; the wide figure only steals
     horizontal room WITHIN the middle, not from cols 1 or 4. */
  .mid-wide {
    grid-column: 2 / 4;
    display: flex;
    flex-direction: column;
    gap: 28pt;
    min-height: 0;
  }
  .mid-wide > .section { flex: 0 0 auto; }
  .mid-wide > .section.grow { flex: 1 1 auto; }
  /* Sub-grid INSIDE the wide block: splits the bottom area into 2 columns.
     STRICT 2-col by design — when the paper doesn't introduce a dataset
     and Dataset is dropped, the LLM MUST fill the second slot with
     something else (Headline Numbers, Ablation, a secondary figure, or
     a split Key Result with 2 sub-panes). A lone card here would visually
     span both middle columns and reproduce the old broken layout. The
     `polish` gate emits MID/SUBFILL when this slot is under-filled —
     do not work around it by relaxing this grid to auto-fit. */
  .mid-sub {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* Default `align-items: stretch` (grid default) — both sub-cards
       equalize to the row track height so their bottoms align with each
       other AND mid-sub's bottom aligns with the outer column. Earlier
       attempt with `align-items: start` let the taller card's natural
       height push past mid-sub's flex allocation, breaking column-bottom
       alignment with the outer left/right columns. Keep contents within
       mid-sub's allocated height — trim or rebalance content rather than
       loosening this constraint. */
    gap: 28pt;
    flex: 1 1 auto;
    min-height: 0;
  }
  .mid-sub > .section { min-height: 0; }
  /* Method's figure inside the wide block can occupy the full mid-wide width
     (cols 2-3 of outer grid) — typically 2.5× a normal column. .method-body
     stacks bullets above figure (the same orientMethod flip logic applies).
     The figure caption fit() script handles vertical sizing. */
  .mid-wide .method-body { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
  .mid-wide .method-body > ul { flex: 0 0 auto; }
  .mid-wide .method-body > figure { flex: 1 1 auto; margin-top: 0.5em; }
  /* ══════════════ METHOD-DRIVEN subsection cards (.msub) ══════════════
     Opt-in via --layout methoddriven. The Method owns the wide middle
     block and is split into SOLID ROUNDED subsection cards that organize
     its sub-parts. Depth ramp d1..d4 (multi-accent) is keyed off --accent
     so it tracks the theme. Specificity (.mid-wide .section.msub) beats the
     style layer's `.section` rules, so this overrides them regardless of
     the STYLE_CSS injection order below. Cards arrange 1-3 per row via
     .mid-sub / .mid-sub-3 (chosen per-paper at fill time). */
  .mid-wide .section.msub {
    border-top: none; border-radius: 0.7em;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    background: color-mix(in srgb, var(--accent) 12%, #fff);
  }
  .mid-wide .section.msub::before { display: none !important; }  /* kill any style-layer ::before bar */
  .mid-wide .section.msub.d1 { background: color-mix(in srgb, var(--accent)  8%, #fff); }
  .mid-wide .section.msub.d2 { background: color-mix(in srgb, var(--accent) 13%, #fff); }
  .mid-wide .section.msub.d3 { background: color-mix(in srgb, var(--accent) 18%, #fff); }
  .mid-wide .section.msub.d4 { background: color-mix(in srgb, var(--accent) 23%, #fff); }
  /* multi-hue opt-in (add class `mhue` on <body>): distinct harmonized hues per position */
  body.mhue .mid-wide .section.msub.d1 { --accent:#1f5fa8; background: color-mix(in srgb,#1f5fa8 13%,#fff); }
  body.mhue .mid-wide .section.msub.d2 { --accent:#17868a; background: color-mix(in srgb,#17868a 13%,#fff); }
  body.mhue .mid-wide .section.msub.d3 { --accent:#7a4fb0; background: color-mix(in srgb,#7a4fb0 13%,#fff); }
  body.mhue .mid-wide .section.msub.d4 { --accent:#b5701f; background: color-mix(in srgb,#b5701f 13%,#fff); }
  .msub .msub-h { display: flex; align-items: center; gap: 0.4em; margin: 0 0 0.35em 0;
    font-size: 1.05em; line-height: 1.15; }
  .msub .msub-h .msub-t { margin: 0; font-size: 1em; font-weight: 800; color: var(--accent); }
  .msub .msub-h .n { flex: 0 0 auto; width: 1.5em; height: 1.5em; border-radius: 50%;
    background: var(--accent); color: #fff; font-size: 0.8em; font-weight: 800;
    display: flex; align-items: center; justify-content: center; }
  .msub .msub-h .k { margin-left: auto; font-size: 0.62em; font-weight: 600;
    font-style: italic; color: var(--muted, #5b6572); }
  .msub .msteps { display: flex; align-items: center; gap: 0.3em; margin-top: 0.4em; }
  .msub .msteps .s { flex: 1; text-align: center; font-size: 0.82em; font-weight: 700;
    color: var(--accent); background: #fff; border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    border-radius: 0.35em; padding: 0.3em 0.2em; }
  .msub .msteps .a { color: var(--accent); font-weight: 800; }
  .mid-sub-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--gap, 10px); }
  .mid-sub-3 > .section { min-height: 0; }
  /* The whole Method lives in ONE visual container (.method-wrap) so the subsection
     cards read as PART OF Method, not loose sibling sections. The wrapper is a .section
     (gets the style-layer card chrome = the Method box) but data-measure-skip, so slack
     measures the inner .msub subsections, not the wrapper. */
  .mid-wide > .section.method-wrap { --method-fig-max: 42cqh; flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
  /* FIGURE-PRIORITY: the Method figure is the dominant visual, not a small stamp. It fills
     the column WIDTH (a wide banner then clears the 90% figure-fill gate on width) and is
     bounded only by a generous, fill-loop-tunable height guard so a merely-moderate-AR
     figure can't swallow the whole column. Raise/lower --method-fig-max to trade figure
     size against card room; the figcaption flows below. */
  .method-wrap > .method-figure { flex: 0 0 auto !important; display: flex !important; flex-direction: column !important; height: auto !important; margin: 0.4em 0 0 0 !important; }
  .method-wrap > .method-figure img { width: 100% !important; height: auto !important; max-height: var(--method-fig-max, 42cqh) !important; object-fit: contain !important; flex: 0 0 auto !important; }
  /* MASONRY subsection cards: each card sizes to ITS OWN content (no forced-equal-height
     rows). column-count:2 packs them into two balanced sub-columns; break-inside:avoid
     keeps a card whole. Fixes the rigid-grid failure where a low-content card was
     stretched (blank) and a high-content card was crushed (overflow). */
  /* 2-col grid, rows sized to CONTENT (grid-auto-rows:min-content) and cards NOT
     stretched (align-items:start): each card hugs its content and every card is fully
     visible — no forced-equal-height overflow, no clipped cards. overflow:visible so the
     Method container never clips a card. Content is balanced across cards by the fill loop
     so the row gaps stay small. */
  .method-wrap { overflow: visible !important; }
  /* VARIABLE ARRANGEMENT (fill-loop-driven): a 2-col grid whose rows share the room the
     figure left. `dense` auto-placement means the DEFAULT (all-normal cards) packs into a
     clean 2xN. The fill loop composes richer arrangements per-paper by tagging individual
     cards + choosing card ORDER — no fixed structure:
       .msub.wide  -> full-width long ROW (place it FIRST = top row, LAST = bottom row)
       .msub.tall  -> TALL card spanning 2 rows (the two normal cards flow the other column)
       .msubs.cols-3 (on the container) -> a 3-up equal-column row
     e.g. tall+2 = one .tall + two normal; row-top+2 = a leading .wide + two normal; 2x2 =
     four normal; 3-up = .cols-3 + three normal. Every .msub is still measured per-section by
     slack (FULL 0.90-1.00); align-items:stretch + 1fr rows make cards fill their cell. */
  .method-wrap > .msubs { flex: 1 1 auto; display: grid; grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr; grid-auto-flow: row dense; align-items: stretch;
    gap: var(--gap, 12px); margin-top: 0.5em; min-height: 0; }
  .method-wrap > .msubs.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
  .method-wrap > .msubs > .section.msub { margin: 0; min-height: 0; }
  .method-wrap > .msubs > .section.msub.wide { grid-column: 1 / -1; }
  .method-wrap > .msubs > .section.msub.tall { grid-row: span 2; }
  /* Sections share vertical space inside their column. The class `.section.grow` absorbs leftover space. */
  /* Each section is a positioning context so the per-section Listen button can float
     absolutely inside it, anchored to the top-right corner. Floating the button takes
     it out of the heading's flex row entirely — no width is reserved for it, so the
     heading text spans the full section width whether the button is shown, hidden, or
     toggling between idle ("▶ Listen") and playing ("■ Listen") states. Without this,
     even small width changes (e.g. the symbol/colour swap on play) could nudge the
     heading text and ripple subtle reflow through the column. */
  /* Each section is a positioning context so the per-section Listen button can float
     absolutely inside it, anchored to the top-right corner. Floating the button takes
     it out of the heading's flex row entirely — no width is reserved for it, so the
     heading text spans the full section width whether the button is shown, hidden, or
     toggling between idle ("▶ Listen") and playing ("■ Listen") states. Without this,
     even small width changes (e.g. the symbol/colour swap on play) could nudge the
     heading text and ripple subtle reflow through the column. */
  /* STYLE_CSS hook = the swappable STYLE layer (assets/styles/<style>.css):
     :root theme vars + .section / .section::before / .section h2 visual
     treatment. Injected by compose_poster.py. The structural section rules
     (takeaway callout, .grow, .playing) stay below as shared base CSS. */
  /* tinted.css — 'Tinted Card' body-block style (section card + h2). Adapts the
   gallery block to the real poster (.section padding/flex unchanged, h2 60pt).
   Theme/header ride the SOLID defaults (flat white chips) via --tb-chip-shadow. */
:root { --fig-img-radius: 4px; --tb-chip-shadow: none; }
.section {
    position: relative; padding: 21pt; display: flex; flex-direction: column; min-height: 0; overflow: hidden;
  background:color-mix(in srgb, var(--accent) 7%, #fff); border:1px solid color-mix(in srgb, var(--accent) 22%, #fff); border-radius:7pt;
}
.section h2 {
  margin: 0 0 0.4em 0; font-size: 46pt; line-height: 1.1; font-weight: 800;
  color:var(--accent);
}

  /* Takeaway is the poster's mic-drop. Treat it as a callout box: stronger
     tinted background + thicker left accent border, like a pull-quote in
     editorial design. Doesn't change card dimensions — bg color and a 6 px
     left border live inside the existing padding box. */
  .section[data-section="takeaway"] {
    background: color-mix(in srgb, var(--accent-soft) 70%, var(--bg));
    border-left: 6px solid var(--accent);
  }
  /* Per-section color binding removed — all sections now share the theme accent for
     borders, headings, inline emphasis, and Listen buttons. */
  .section.grow { flex: 1 1 auto; }
  /* When this section's narration is playing, lift its border so the eye knows where to look.
     Use `outline` (not border-width) so the highlight doesn't reflow the section's content
     — a thicker border would steal 1.5px per side from the inner box and push text into
     extra lines mid-playback. Outlines paint outside the box and leave layout untouched. */
  .section.playing {
    border-color: var(--play-highlight);
    outline: 2px solid var(--play-highlight);
    outline-offset: 0px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--play-highlight) 15%, transparent);
    transition: border-color 0.2s, box-shadow 0.2s, outline-color 0.2s;
  }
  /* Title narration playing — ring the whole titlebar like a section. Inset
     (negative offset + inset glow) so the ring stays inside the poster's top
     edge instead of being clipped. Titlebar carries data-section="title". */
  .titlebar.playing {
    outline: 3px solid var(--play-highlight);
    outline-offset: -3px;
    box-shadow: inset 0 0 0 6px color-mix(in srgb, var(--play-highlight) 18%, transparent);
    transition: outline-color 0.2s, box-shadow 0.2s;
  }
  .section p { margin: 0 0 0.5em 0; }
  .section ul { margin: 0; padding-left: 1.1em; }
  .section li { margin-bottom: 0.35em; }
  /* Inline emphasis vocabulary — three tools to guide the reader's eye through dense prose.
     All three share ONE highlight color (--highlight-accent / --highlight-soft, locked to
     (--highlight-accent / --highlight-soft, near-black #111) so highlighted words read as one consistent "look-here" signal across
     the whole poster, not eight different per-section colors that fragment the reader's
     attention. The section's own --section-accent is still used for chrome (Listen button),
     but deliberately NOT for inline emphasis. Use sparingly: 1-3 hits per section max. */
  .section strong, .section b { color: var(--highlight-accent); font-weight: 700; }
  .section .hi {
    background: var(--highlight-soft);
    color: var(--highlight-accent);
    padding: 0.05em 0.35em;
    border-radius: 4px;
    font-weight: 600;
    /* Box-decoration-break keeps the tint continuous when the highlight wraps across lines. */
    -webkit-box-decoration-break: clone;
            box-decoration-break: clone;
  }
  .section .num {
    color: var(--highlight-accent);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    /* A hair larger so numerals pop without breaking the line grid. */
    font-size: 1.06em;
  }
  /* Callout — a one-line punchline pill any section can carry below its body when it has
     a single sentence-level "shout this" claim. Two variants:
       • .callout         → centered pill, accent-tinted background, best for results-style claims
       • .callout.callout-bar → left-aligned with a 4px accent bar on the left, best for narrative
                                 sections (Takeaway, Problem) where the sentence is the mic-drop
     Both share the same color treatment so the poster has one consistent emphasis vocabulary. */
  .callout {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 0.55em 0.95em;
    /* Symmetric top + bottom margin so a callout at the BOTTOM of a section
       (e.g. .takeaway's mic-drop line) doesn't sit flush against the card's
       inner padding edge. Without bottom margin the callout's colored
       background pushes content_bbox up to fillRatio > 1.0 — slack reports
       FULL (because fullRatio stays in band) but the eye sees the callout's
       bg-tinted box visibly crowding the card border. */
    margin: 0.55em 0;
    font-weight: 700;
    text-align: center;
    font-size: 0.98em;
    line-height: 1.35;
  }
  .callout.callout-bar {
    border-radius: 4px;
    text-align: left;
    border-left: 4px solid var(--accent);
    padding: 0.5em 0.8em;
    background: var(--accent-soft);
  }
  /* `.conclusion` — quiet "so-what" line under Key Results and Ablation Study. Distinct
     visual register from `.callout` (italic, top-bordered, muted) so the section reads
     as numbers → punchline, not pill stacked on pill. See full template for full rationale. */
  .conclusion {
    margin: 0.55em 0 0 0;
    padding-top: 0.45em;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 35%, transparent);
    font-style: italic;
    font-size: 0.92em;
    line-height: 1.4;
    color: var(--text);
  }
  .conclusion::before {
    content: "So what \2192  ";
    font-style: normal;
    font-weight: 700;
    font-size: 0.78em;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--highlight-accent);
    margin-right: 0.35em;
  }
  .number { color: var(--callout); font-weight: 700; }

  /* Arch — a stacked-row architecture diagram. Use it inside any section (especially
     Motivation) when the section's story is a layered architecture or a tiered stack —
     e.g., "data layer / model layer / agent layer", "raw repo / encoding / operation".
     Each .arch-row is a labeled banner; stacked rows read top-to-bottom as the architecture
     stack. Skip it if the story is purely sequential (use prose) or a flat set of properties.

     Markup:
       <div class="arch">
         <div class="arch-row"><span class="arch-label">Top</span><span class="arch-body">Agent</span></div>
         <div class="arch-row"><span class="arch-label">Mid</span><span class="arch-body">RPG</span></div>
         <div class="arch-row"><span class="arch-label">Base</span><span class="arch-body">Code</span></div>
       </div>
     If you only need one piece of text per row, omit .arch-label. */
  .arch {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0.55em 0 0 0;
  }
  .arch-row {
    display: flex;
    align-items: center;
    gap: 0.6em;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 4px;
    padding: 0.4em 0.7em;
    font-weight: 700;
    font-size: 0.95em;
    line-height: 1.25;
  }
  /* Progressive tint so rows read as layers (top lighter, base stronger). */
  .arch-row:nth-child(1) { background: color-mix(in srgb, var(--accent) 8%, white); }
  .arch-row:nth-child(2) { background: color-mix(in srgb, var(--accent) 14%, white); }
  .arch-row:nth-child(3) { background: color-mix(in srgb, var(--accent) 20%, white); }
  .arch-row:nth-child(4) { background: color-mix(in srgb, var(--accent) 26%, white); }
  .arch-label {
    font-size: 0.72em;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 800;
    opacity: 0.75;
    flex: 0 0 auto;
    min-width: 4.2em;
  }
  .arch-body { flex: 1 1 auto; }

  /* Figure scales to fill the section's remaining vertical room — kills blank space.
     The IMG is itself a flex child so it shrinks (rather than overflows) when the figure
     box is tight, leaving the figcaption inside the section. Without `flex: 1 1 auto` +
     `min-height: 0` on the img, intrinsic image height bullies the caption out of the
     section's bounds — which is exactly the bug to avoid. */
  figure { margin: 0.5em 0 0 0; text-align: center; display: flex; flex-direction: column; align-items: center; flex: 1 1 auto; min-height: 0; overflow: hidden; }
  figure img { flex: 1 1 auto; min-width: 0; min-height: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; border: 1px solid #e5e5e0; border-radius: var(--fig-img-radius, 4px); background: white; }
  figcaption { flex: 0 0 auto; font-size: 0.82em; color: var(--muted); margin-top: 0.35em; font-style: italic; max-width: 92%; line-height: 1.3; }

  /* Method body: wraps the bullets + figure so the on-load fit script can
     switch their arrangement by comparing the figure's aspect ratio to the
     aspect of its stacked slot (see orientMethod in the footer script).
     - Default / stacked: bullets on top, figure spans the full column width
       below. Used for every LANDSCAPE figure (w_fig/h_fig >= 1) and for any
       portrait figure that isn't narrower than its slot. A wide pipeline
       diagram wants the whole width.
     - `.method-horizontal`: a two-column row — bullets left, figure right.
       Used only when the figure is BOTH portrait (w_fig/h_fig < 1) AND
       narrower than its stacked slot (w_fig/h_fig < w_slot/h_slot) AND the
       bullets' 42% share still clears the readable-width floor (min-width:
       22em). Such a figure stacked full-width would paint narrow with a tall
       band of dead space beside it; the row hands it a taller slot it fills on
       height, and the bullets reclaim the horizontal whitespace. The portrait
       condition guards against a crowded column's wide-short slot dragging a
       landscape figure into the row (where it can't fill and leaves a void);
       the bullet-width floor guards against a narrow column starving the text
       into a 2–3-word ribbon (better to stay stacked than read badly). */
  .method-body { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
  .method-body > ul { flex: 0 0 auto; }
  /* Method bullets are short, punchy single-line phrases. A slightly tighter
     line-height and inter-item gap (vs the default .section li) frees vertical
     room for a height-bound landscape figure stacked below: every px the bullet
     stack gives up, the figure box gains, so a wide figure can reach the 70%
     fill target instead of painting narrow with side gutters. Honest figure
     sizing (the fit() pass reserves the caption's true wrapped height) makes
     this headroom matter -- without it a wide Method figure tends to land just
     under 70% and trip the FIG/NARROW polish check. Safe for one-line bullets;
     a wrapped bullet still reads fine at 1.3. */
  .method-body > ul li { line-height: 1.3; margin-bottom: 0.18em; }
  /* Method figure FLOOR. Without this, a Method section that does NOT carry
     `.grow` (because a sibling like Key Results carries it instead) collapses
     to fit content -- so when fit() collapses the image to 1px to measure the
     vertical budget, the section's auto height shrinks too, and the budget
     reads as ~caption-only. The image is then pinned tiny in a wide column
     (e.g. 5:1 image rendered ~1000x200 on a 2400-wide column = 42% width,
     tripping FIG/NARROW since neither axis clears 70%). The CSS hint here
     is a SOFT 14cqh (~480px on the 5760x3456 canvas) so the section
     reserves a sane initial slot; the fit() script enforces the HARD floor
     (24cqh ≈ 830px) when it measures and sizes the image -- see the
     `MIN_METHOD_FIG_BUDGET_CQH` constant in the fit script below. Skipped
     in `.method-horizontal` because the row layout already gives the figure
     a full-column-HEIGHT slot beside the bullets. */
  .method-body > figure { flex: 1 1 auto; min-height: 14cqh; }
  .method-body.method-horizontal { flex-direction: row; align-items: flex-start; gap: 24pt; }
  .method-body.method-horizontal > figure { min-height: 0; }
  /* In the row layout the bullets take a readable share and the figure takes the
     rest; both stretch to the row's full height so a tall figure fills vertically.
     The `min-width` floor (~22em) keeps the text at a comfortable measure: it
     stops a narrow column or a greedy portrait figure from collapsing the bullets
     into a 2–3-word-per-line ribbon. If 42% of the row would already fall below
     this floor, orientMethod() vetoes the flip and the body stays stacked (a
     full-width figure with bullets above always out-reads starved side-by-side
     text). Keep this value in sync with MIN_BULLET_W in the footer script. */
  .method-body.method-horizontal > ul     { flex: 0 1 42%; min-width: 22em; align-self: center; }
  .method-body.method-horizontal > figure { flex: 1 1 58%; min-width: 0; align-self: stretch; margin-top: 0; }

  /* Density helpers — use these to *fill* a sparse section with real content, not padding. */
  /* Headline Numbers — "hero + supporting" layout:
     ONE big number gets the eye (the paper's signature result), with
     three smaller supporting metrics under a thin divider. Replaces the
     old 2×2 grid of bordered stat boxes, which read as "card-in-card"
     visual noise and forced uppercase labels to wrap awkwardly. */
  /* Headline Numbers — promoted from quiet-white to a filled accent block.
     The whole hero sits inside its section card (which has our new bg +
     stripe), but now it's clearly a "spotlight" rather than another body
     paragraph: tinted background, accent-colored numbers, white-ish supporting
     tiles. Visual weight matches the section's importance ("here are the
     headline results — look here"). Layout dims unchanged: same column-flex
     content as before, just colored. */
  .headline-hero {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    align-items: center;
    text-align: center;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--accent) 12%, white),
      color-mix(in srgb, var(--accent) 6%, white));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 8px;
    padding: 18pt 20pt 14pt;
    /* Subtle inner glow toward the accent — gives the block a slight depth. */
    box-shadow: inset 0 0 32pt color-mix(in srgb, var(--accent) 6%, transparent),
                0 2px 4px rgba(0,0,0,0.03);
  }
  .headline-hero .hero-val   { font-size: 108pt; color: var(--accent); font-weight: 800; line-height: 0.95; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .headline-hero mjx-container[jax="SVG"] { max-width: 100% !important; }
  .headline-hero mjx-container svg { max-width: 100% !important; height: auto !important; }
  .headline-hero .hero-val mjx-container[jax="SVG"] { font-size: 46% !important; }
  .headline-hero .hero-label { font-size: 30pt; color: var(--text); font-weight: 600; line-height: 1.1; margin-top: 0.05em; }
  .headline-hero .hero-note  { font-size: 23pt; color: var(--muted); font-style: italic; line-height: 1.15; }
  .headline-hero .supporting {
    display: flex;
    align-items: flex-start;
    justify-content: space-around;
    gap: 1em;
    width: 100%;
    margin-top: 0.5em;
    padding-top: 0.6em;
    border-top: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .headline-hero .stat-mini {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    flex: 1 1 0;
    min-width: 0;
    /* No background on supporting tiles — they sit naked on the hero's
       gradient ground. The previous white-pad rectangle made the trio
       look like disjointed mini-cards. */
  }
  .headline-hero .stat-mini .val { font-size: 54pt; color: var(--callout); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .headline-hero .stat-mini .lbl { font-size: 22pt; color: var(--muted); line-height: 1.2; margin-top: 0.2em;  min-height: 2.4em; /* ALIGN-FIX: reserve 2 lines so 1-line and 2-line labels occupy identical height -> the .val numbers above always line up. */ }
  /* Compact left/right Headline Numbers (2026-07-04). The centered column
     stacked the hero value over a full-width row of 3 supporting stats, which
     read WIDE and SPARSE (three small numbers marooned across the whole card).
     When the hero value is wrapped in `.hero-main` (current template), lay the
     card out as hero-on-the-LEFT + supporting stats stacked on the RIGHT under
     a vertical divider: denser, fills the box, and the right rail holds the
     stats without stretching. Purely additive — a legacy hero without
     `.hero-main` keeps the old centered column layout. */
  .headline-hero:has(.hero-main) { flex-direction: row; align-items: stretch; text-align: left; gap: 1.1em; }
  .headline-hero .hero-main { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .headline-hero:has(.hero-main) .hero-val { font-size: 120pt; }
  .headline-hero:has(.hero-main) .supporting {
    flex: 0 0 auto; flex-direction: column; width: auto; max-width: 44%;
    margin-top: 0; padding-top: 0; padding-left: 0.9em;
    border-top: none; border-left: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    justify-content: center; gap: 0.5em;
  }
  .headline-hero:has(.hero-main) .stat-mini { flex-direction: row; align-items: baseline; gap: 0.35em; text-align: left; }
  .headline-hero:has(.hero-main) .stat-mini .val { font-size: 46pt; }
  .headline-hero:has(.hero-main) .stat-mini .lbl { min-height: 0; margin-top: 0; text-align: left; }

  .stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 0.5em; }
  .stat { background: white; border: 1.5px solid var(--callout); border-radius: 6px; padding: 6px 6px; text-align: center; }
  .stat .val { font-size: 80pt; color: var(--callout); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .stat .lbl { font-size: 0.74em; color: var(--muted); margin-top: 6px; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1.2; }
  table.results { width: 100%; border-collapse: collapse; font-size: 0.93em; margin-top: 0.4em; }
  table.results th, table.results td { padding: 6px 8px; text-align: center; border-bottom: 1px solid #e5e5e0; font-variant-numeric: tabular-nums; }
  table.results th { background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  table.results td.method { text-align: left; font-weight: 600; font-variant-numeric: normal; }
  table.results th:first-child { text-align: left; }  /* first-column header matches its left-aligned method cells (was centered -> misaligned) */
  table.results tr.best td { color: var(--accent); font-weight: 800; background: var(--accent-soft); }


  /* Narration controls. Align listen button to the top of the heading (not center) so
     when h2 text wraps to two lines the button stays anchored at the first line instead of
     drifting to the vertical middle and looking detached from the heading. */
  /* Heading is plain block flow now that the per-section Listen button is absolutely
     positioned out of the heading row (see `.listen-btn`). We pad the right edge so
     the title text never visually collides with the floating button when it's shown. */
  .section h2 { padding-right: 5.5em; }
  /* Headline Numbers has no Listen button, so don't reserve right-edge padding —
     lets the heading sit on one line at narrow column widths. */
  .section[data-section="headline-numbers"] h2 { padding-right: 0; }
  /* Listen buttons are hidden by default — press "a" to reveal them. Keeps the printed/screenshot
     poster clean; reviewers who want audio toggle the controls in. We use `visibility: hidden`
     (not `display: none`) on both kinds of Listen buttons because they're absolutely / fixed
     positioned: visibility keeps them out-of-flow either way, and avoiding `display` changes
     guarantees no layout recompute on the rest of the page when toggling. */
  body:not(.show-listen) .listen-btn { visibility: hidden; }
  body:not(.show-listen) .listen-all { visibility: hidden; }
  .listen-btn {
    position: absolute;
    top: 32pt;
    right: 32pt;
    z-index: 5;
    font-size: 0.7em;
    font-weight: 600;
    color: white;
    background: var(--section-accent, var(--accent));
    border: 1.5px solid white;
    border-radius: 999px;
    padding: 0.25em 0.7em;
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s;
  }
  .listen-btn:hover { background: var(--callout); }
  .listen-btn.playing { background: var(--callout); }
  .listen-btn::before { content: "\25B6  "; font-size: 0.85em; }
  .listen-btn.playing::before { content: "\25A0  "; }
  /* "Listen to full narration" is anchored to the bottom-LEFT of the titlebar so it sits
     in the title region but stays out of normal flow. The smaller "Listen" pill (the
     opening-narration twin of every section's Listen pill) now lives in the TOP-RIGHT
     of the titlebar. Two reasons it's out of flow:
     (1) toggling the audio controls on/off with the "a" key must not reflow the titlebar;
     (2) swapping between the idle "Full Listen" and playing "Stop" labels would otherwise
     change the titlebar's measured height. Absolute positioning inside the titlebar takes
     the button out of flow but keeps it visually tied to the title region. */
  .listen-all {
    /* Anchored to the bottom-LEFT of the titlebar (under the venue badge) so the
       primary "play everything" control sits in its own corner — the small Listen
       pill that mirrors the per-section Listen buttons now lives in the TOP-RIGHT
       of the titlebar. Sized to MATCH the per-section .listen-btn pill (same
       font-size, padding, border-radius, accent fill, white pill border, ▶/■
       iconography) so the chrome reads as one consistent control vocabulary
       across the whole poster. Absolute (not fixed) so it scrolls with the
       poster and stays glued to the header. */
    position: absolute;
    bottom: 32pt;
    left: 48pt;
    z-index: 100;
    font-size: 42pt;         /* matches .listen-btn rendered size (0.7em of h2's 60pt) */
    font-weight: 600;
    background: var(--accent);
    color: white;
    border: 1.5px solid white;
    border-radius: 999px;
    padding: 0.25em 0.7em;   /* matches .listen-btn padding ratio for identical pill size */
    cursor: pointer;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    /* Reserve a stable minimum width so the idle/playing label swap doesn't resize the
       button itself — keeps the click target rock-steady. Sized for the short "Full Listen"
       label; bump this if you rename to something longer. */
    min-width: 7em;
    text-align: center;
    line-height: 1;
    transition: background 0.15s;
  }
  .listen-all:hover { background: var(--callout); }
  .listen-all.playing { background: var(--callout); color: white; }
  .listen-all::before { content: "\25B6  "; font-size: 0.85em; }
  .listen-all.playing::before { content: "\25A0  "; }
  /* Title listen button — small companion to .listen-all that plays the
     paper's opening narration (title + authors + one-sentence framing).
     Sits in the titlebar's TOP-RIGHT corner, sized to MATCH the per-section
     .listen-btn pill (same font-size, padding, border-radius, accent fill,
     white pill border, ▶/■ play/stop iconography) so the chrome reads as one
     consistent control vocabulary across the whole poster — the titlebar's
     "Listen" pill is the opening-narration twin of every section's "Listen"
     pill. Same audio engine (`play("title")`) so it inherits all the
     pause/resume/state-clear logic. Hidden by the same `body:not(.show-listen)`
     gate as the rest of the narration UI. */
  body:not(.show-listen) .listen-title { visibility: hidden; }
  .listen-title {
    position: absolute;
    top: 32pt;
    right: 32pt;             /* top-right corner of the titlebar */
    z-index: 100;
    font-size: 42pt;         /* matches .listen-btn rendered size (0.7em of h2's 60pt) */
    font-weight: 600;
    color: white;
    background: var(--accent);
    border: 1.5px solid white;
    border-radius: 999px;
    padding: 0.25em 0.7em;   /* matches .listen-btn padding ratio for identical pill size */
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s;
  }
  .listen-title:hover { background: var(--callout); }
  .listen-title.playing { background: var(--callout); }
  .listen-title::before { content: "\25B6  "; font-size: 0.85em; }
  .listen-title.playing::before { content: "\25A0  "; }

  /* ---- DEBUG OVERLAY (toggle with "d") -----------------------------------
     Press `d` to outline every laid-out block on the poster and stamp each
     one with its measured size. Labels show:
       • per-section badge: actual rendered height (px), and if a sibling
         poster_debug.json was loaded, the estimator's predicted height plus
         the delta — exposes where measure_layout.js is wrong.
       • per-column badge: live slackRatio computed from actual rendered
         heights vs the column's content area.
     Everything is `pointer-events: none` so the overlay never blocks audio
     controls or text selection. Toggle is `body.debug` so the styles stay
     fully dormant during normal viewing and during PDF/PNG export. */
  body.debug .col          { outline: 2px dashed rgba(29,58,135,0.55); outline-offset: -2px; position: relative; }
  body.debug .section      { outline: 2px solid rgba(174,38,34,0.55); }
  body.debug figure        { outline: 2px solid rgba(34,139,34,0.7); }
  body.debug .stat-grid,
  body.debug .arch,
  body.debug table,
  body.debug .callout      { outline: 1.5px dashed rgba(180,120,0,0.7); }
  body.debug .section p,
  body.debug .section ul,
  body.debug .section ol   { outline: 1px dashed rgba(0,0,0,0.25); outline-offset: -1px; }
  /* Debug chrome (badges + bbox labels/borders) lives INSIDE .poster, which
     the #poster-stage controller scales by `transform: scale(s)` to fit the
     window (s≈0.25 in a normal browser window). Fixed pt/px sizes would shrink
     with it -> unreadably small text + hairline borders. The debug JS sets
     `--dbg-scale: 1/s` on .poster, and every debug size below is multiplied by
     it so the chrome stays a CONSTANT on-screen size at any zoom. Defaults to 1
     (and s===1 in the print viewport), so this is a no-op for the PDF/PNG.
     Sizes are deliberately kept SMALLER than the poster's own on-screen body
     text (~14px) so the long (x,y,w,h) labels fit their section boxes instead
     of overflowing and colliding across cards. */
  .dbg-badge {
    display: none;
    position: absolute;
    z-index: 9999;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    line-height: 1.1;
    padding: calc(2pt * var(--dbg-scale, 1)) calc(5pt * var(--dbg-scale, 1));
    border-radius: 3pt;
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: 0;
  }
  body.debug .dbg-badge    { display: inline-block; }
  .dbg-badge.dbg-col       { top: 4pt; right: 4pt; font-size: calc(9pt * var(--dbg-scale, 1)); background: rgba(29,58,135,0.92); color: #fff; }
  .dbg-badge.dbg-col.over  { background: rgba(174,38,34,0.95); }
  .dbg-badge.dbg-col.ok    { background: rgba(40,120,40,0.95); }
  .dbg-badge.dbg-section   { top: 4pt; right: 4pt; font-size: calc(8pt * var(--dbg-scale, 1)); background: rgba(174,38,34,0.92); color: #fff; }
  .dbg-badge.dbg-section .dbg-delta-pos { color: #ffd1d1; }
  .dbg-badge.dbg-section .dbg-delta-neg { color: #d1ffd1; }

  /* Per-section bbox overlays. Two rectangles per section: the card box
     (the .section's border-box, drawn red) and the content bbox (union of
     the section's children excluding chrome like .listen-btn/.dbg-badge,
     drawn green). Each carries an (x, y, w, h) label in poster-local CSS
     pixels — same coordinate system the `check_poster.py slack` JSON
     reports, so what you see on screen matches what the staged-fill gate
     reads. The whole overlay is pointer-events:none so it never blocks
     audio controls or text selection. */
  .dbg-bbox {
    position: absolute; z-index: 9998; pointer-events: none;
    box-sizing: border-box;
  }
  .dbg-bbox-card    { border: 2px solid rgba(174,38,34,0.85); }
  .dbg-bbox-content { border: 2px dashed rgba(34,139,34,0.95); }
  .dbg-bbox-figure  { border: 2px dashed rgba(180,120,0,0.95); }
  .dbg-bbox-label {
    position: absolute; left: 0; top: -1.4em;
