<script>
(function () {
  // Derive the "now playing" highlight ring so it CONTRASTS the VI theme accent:
  // a blue poster (#1d3a87) gets a red ring, a red poster (#ae2622) gets a blue
  // ring. Without this, a red-VI poster would draw the playback cue in the same
  // red as its own frame and the highlight would be invisible. We read the live
  // --accent (set by template substitution), measure how red-vs-blue it leans,
  // and pick the opposite preset.
  (function setPlayHighlight() {
    const root = document.documentElement;
    const cs = getComputedStyle(root);
    const accent = (cs.getPropertyValue("--accent") || "").trim();
    const red = cs.getPropertyValue("--play-highlight-red").trim() || "#ae2622";
    const blue = cs.getPropertyValue("--play-highlight-blue").trim() || "#1d3a87";
    // Parse the accent to RGB (handles #rgb / #rrggbb) to decide its dominant hue.
    let r = 0, g = 0, b = 0;
    const m = accent.replace("#", "");
    if (m.length === 3) { r = parseInt(m[0] + m[0], 16); g = parseInt(m[1] + m[1], 16); b = parseInt(m[2] + m[2], 16); }
    else if (m.length >= 6) { r = parseInt(m.slice(0, 2), 16); g = parseInt(m.slice(2, 4), 16); b = parseInt(m.slice(4, 6), 16); }
    // Reddish accent -> blue ring; otherwise (bluish/neutral) -> red ring.
    root.style.setProperty("--play-highlight", r >= b ? blue : red);
  })();

  const PLAYLIST = ["title", "problem", "motivation", "method", "key-result", "takeaway"];
  const player = document.getElementById("narration-player");
  const sectionBtns = document.querySelectorAll(".listen-btn, .listen-title");
  const listenAll = document.querySelector("[data-listen-all]");
  let current = null;        // section id currently playing
  let queue = [];            // remaining section ids when playing-all

  function srcFor(id) { return "assets/audio/" + id + ".mp3"; }
  function btnFor(id) { return document.querySelector('.listen-btn[data-section="' + id + '"], .listen-title[data-section="' + id + '"]'); }
  function sectionFor(id) {
    // Region to ring while `id` plays. Sections live in .section; the opening
    // "title" narration rings the whole .titlebar (carries data-section="title").
    return document.querySelector(
      '.section[data-section="' + id + '"], .titlebar[data-section="' + id + '"]');
  }

  function clearState() {
    // One sweep clears every highlight: section buttons, section rings, the
    // titlebar ring, and the Full-Listen pill.
    document.querySelectorAll(".playing").forEach(e => e.classList.remove("playing"));
    current = null;
  }

  function play(id, opts) {
    opts = opts || {};
    if (current === id && !player.paused) { player.pause(); return; }
    clearState();
    current = id;
    player.src = srcFor(id);
    const p = player.play();
    if (p && p.catch) p.catch(err => { console.warn("audio play failed for " + id, err); clearState(); });
    const btn = btnFor(id);
    if (btn) btn.classList.add("playing");
    const sec = sectionFor(id);
    if (sec) sec.classList.add("playing");
    if (opts.fromAll) listenAll.classList.add("playing");
  }

  sectionBtns.forEach(btn => {
    btn.addEventListener("click", e => {
      e.stopPropagation();
      queue = []; // a manual click cancels the play-all queue
      play(btn.dataset.section);
    });
  });

  listenAll.addEventListener("click", () => {
    if (listenAll.classList.contains("playing")) {
      queue = [];
      player.pause();
      clearState();
      return;
    }
    queue = PLAYLIST.slice();
    const first = queue.shift();
    if (first) play(first, { fromAll: true });
  });

  player.addEventListener("ended", () => {
    const wasPlayAll = listenAll.classList.contains("playing");
    clearState();
    if (wasPlayAll && queue.length) {
      const next = queue.shift();
      play(next, { fromAll: true });
    } else {
      queue = [];
    }
  });

  player.addEventListener("pause", () => {
    if (player.ended) return;
    // user paused mid-clip — drop highlighting but keep src so resume works
    document.querySelectorAll(".playing").forEach(e => e.classList.remove("playing"));
  });
})();
</script>

<script>
// Keyboard shortcuts: "s" toggles fullscreen, "a" toggles the Listen audio controls.
// Skip when the user is typing into a form field so we don't hijack text input.
(function () {
  function isTyping(el) {
    if (!el) return false;
    const tag = el.tagName;
    return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || el.isContentEditable;
  }
  // When fullscreen turns on/off, re-fit the poster to the new viewport.
  // The #poster-stage controller (defined at the very end of <body>) owns the
  // transform; here we just ask it to recompute. It scales box + content
  // together, so fullscreen fills the screen with the whole poster visible.
  function syncPosterFit() {
    if (window.__fitPosterStage) window.__fitPosterStage();
  }
  document.addEventListener("fullscreenchange", syncPosterFit);
  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (isTyping(e.target)) return;
    const k = e.key.toLowerCase();
    if (k === "s") {
      e.preventDefault();
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen().catch(err => console.warn("fullscreen failed", err));
      }
    } else if (k === "a") {
      e.preventDefault();
      document.body.classList.toggle("show-listen");
    } else if (k === "d") {
      e.preventDefault();
      window.__togglePosterDebug && window.__togglePosterDebug();
    }
  });
})();
</script>

<script>
// Debug overlay: bounding boxes + per-section/per-column size labels.
// Toggled by `d` (see keybindings script above). The CSS in <style> already
// paints the outlines via `body.debug`; this script computes and stamps
// numeric labels on first toggle, and re-stamps on every subsequent toggle
// so the values stay accurate if the poster content changed.
//
// Estimator deltas: if a sibling file named `poster_debug.json` sits next
// to this HTML and contains `{ columns: [{ index, sections: [{ id, used }] }] }`
// (the exact shape `measure_layout.js --json` already emits), each section
// badge gains an "est=NNNpx (Δ±NN)" line so you can see where the estimator
// is off. Loaded lazily on first toggle; missing file is silent.
(function () {
  let estimates = null;          // { "problem": estPx, ... } once loaded
  let estimatesTried = false;

  function loadEstimates(cb) {
    if (estimatesTried) { cb(); return; }
    estimatesTried = true;
    // Resolve sibling URL; works for file:// too (fetch may fail there — that's OK).
    const url = new URL("poster_debug.json", document.baseURI).toString();
    fetch(url).then(r => r.ok ? r.json() : null).then(j => {
      if (!j || !Array.isArray(j.columns)) { cb(); return; }
      estimates = {};
      for (const c of j.columns) {
        for (const s of (c.sections || [])) {
          if (s && s.id) estimates[s.id] = s.used;
        }
      }
      cb();
    }).catch(() => cb());
  }

  function clearBadges() {
    document.querySelectorAll(".dbg-badge, .dbg-bbox").forEach(n => n.remove());
  }

  // Stamp two rectangles per section onto the .poster: the card border-box
  // and the content union (children excluding chrome). Coordinates are
  // poster-local CSS pixels — the same frame `check_poster.py slack`
  // reports — so the visible boxes match the JSON the staged-fill gate
  // reads. Drawn as siblings of the column grid inside .poster, NOT as
  // children of each section, so the absolute positioning resolves
  // against one stable origin.
  function stampBboxes() {
    const poster = document.querySelector(".poster");
    if (!poster) return;
    const pr = poster.getBoundingClientRect();
    // The #poster-stage controller scales .poster by `transform: scale(s)` to
    // fit the window, so getBoundingClientRect() returns post-transform SCREEN
    // pixels. offsetWidth is the untransformed layout width (always the 5760
    // canvas), so s = pr.width / offsetWidth recovers the live scale. Divide
    // every screen-space delta by s to get canvas-local coords that (a) match
    // check_poster.py slack's JSON and (b) render correctly once re-scaled by
    // the transform: the .dbg-bbox divs are appended INSIDE the scaled .poster,
    // so a value left in screen px would be scaled a SECOND time -> the s^2
    // shrink-into-the-top-left bug. In the print viewport s===1 (no-op).
    const s = poster.offsetWidth ? pr.width / poster.offsetWidth : 1;
    // Counter-scale all debug chrome (badges + bbox labels) by 1/s so the text
    // stays a constant on-screen size despite the stage's transform: scale(s).
    // CSS reads it as `calc(<pt> * var(--dbg-scale))`. s===1 at print -> no-op.
    poster.style.setProperty("--dbg-scale", (s > 0 ? 1 / s : 1).toFixed(4));
    const r2 = (n) => Math.round(n * 10) / 10;
    const toLocal = (r) => ({
      x: r2((r.left - pr.left) / s), y: r2((r.top - pr.top) / s),
      w: r2(r.width / s),            h: r2(r.height / s),
    });
    // Make sure the .poster is positioned so our absolute rects anchor here.
    // The templates set `.poster` to no explicit position; flip to relative
    // only while debugging so we don't disturb the print layout.
    poster.style.position = poster.style.position || "relative";
    document.querySelectorAll(".section[data-section]").forEach(sec => {
      const id = sec.getAttribute("data-section");
      const card = toLocal(sec.getBoundingClientRect());
      // Deep walk -- mirrors `check_poster.py slack`. See slack.py for the
      // full rationale: a descendant overflowing an intermediate wrapper
      // (e.g. <figure> overflowing .method-body) still contributes its true
      // bbox to the section's content union, so the on-screen badge reads
      // the same OVERFLOW / SPILLAGE the staged-fill gate does.
      let l = +Infinity, t = +Infinity, r = -Infinity, b = -Infinity, any = false;
      const walk = (el) => {
        if (!el.classList) return;
        if (el.classList.contains("listen-btn")) return;
        if (el.classList.contains("dbg-badge"))  return;
        if (el.classList.contains("dbg-bbox"))   return;
        const rc = el.getBoundingClientRect();
        if (rc.width > 0 || rc.height > 0) {
          l = Math.min(l, rc.left);  t = Math.min(t, rc.top);
          r = Math.max(r, rc.right); b = Math.max(b, rc.bottom);
          any = true;
        }
        Array.from(el.children).forEach(walk);
      };
      Array.from(sec.children).forEach(walk);
      const content = any ? toLocal({left:l, top:t, right:r, bottom:b,
                                     width:r-l, height:b-t}) : null;
      let fullStr = null;
      if (content && card && card.h > 0) {
        const fr = (content.y + content.h - card.y) / card.h;
        let verdict;
        if (fr > 1.10)       verdict = "OVERFLOW";
        else if (fr >= 1.00) verdict = "SPILLAGE";
        else if (fr >= 0.90) verdict = "FULL";
        else if (fr >= 0.70) verdict = "SPARSE";
        else                 verdict = "EMPTY";
        fullStr = `ratio=${(fr * 100).toFixed(1)}%  [${verdict}]`;
      }
      const draw = (cls, box, extra) => {
        if (!box) return;
        const el = document.createElement("div");
        el.className = "dbg-bbox " + cls;
        el.style.left   = box.x + "px";
        el.style.top    = box.y + "px";
        el.style.width  = box.w + "px";
        el.style.height = box.h + "px";
        const label = document.createElement("div");
        label.className = "dbg-bbox-label";
        const tag = cls === "dbg-bbox-card" ? "card"
                  : cls === "dbg-bbox-figure" ? "figure" : "content";
        let txt = `${id} ${tag}  x=${box.x} y=${box.y} w=${box.w} h=${box.h}`;
        if (extra) txt += "  " + extra;
        label.textContent = txt;
        el.appendChild(label);
        poster.appendChild(el);
      };
      draw("dbg-bbox-card",    card, null);
      draw("dbg-bbox-content", content, fullStr);
      // Per-figure bbox: (x,y,w,h) plus the width ratio against the section
      // card (w_figure / w_section). The ratio is the lever the staged-fill
      // loop's figure-sizing tier reasons about, so surface it on-screen too.
      sec.querySelectorAll("figure").forEach(fig => {
        const rc = fig.getBoundingClientRect();
        if (rc.width === 0 && rc.height === 0) return;
        const box = toLocal(rc);
        const ratio = card && card.w > 0 ? box.w / card.w : 0;
        draw("dbg-bbox-figure", box, `ratio=${(ratio * 100).toFixed(1)}% w/w_section`);
      });
    });
  }

  function stampBadges() {
    clearBadges();
    // Column badges — slackRatio from the column's contentBox.
    document.querySelectorAll(".columns > .col").forEach((col, i) => {
      const cs = getComputedStyle(col);
      const padT = parseFloat(cs.paddingTop) || 0;
      const padB = parseFloat(cs.paddingBottom) || 0;
      const inner = col.clientHeight - padT - padB;
      let used = 0;
      const kids = Array.from(col.children).filter(el => !el.classList.contains("dbg-badge"));
      kids.forEach(el => { used += el.offsetHeight; });
      // Approximate row-gap contribution.
      const gap = parseFloat(cs.rowGap || cs.gap) || 0;
      if (kids.length > 1) used += gap * (kids.length - 1);
      const slack = inner - used;
      const ratio = inner > 0 ? slack / inner : 0;
      const badge = document.createElement("div");
      badge.className = "dbg-badge dbg-col " + (ratio < -0.02 ? "over" : (ratio <= 0.08 ? "ok" : ""));
      badge.textContent = `col${i}  used=${Math.round(used)} / ${Math.round(inner)}  slack=${(ratio*100).toFixed(1)}%`;
      // The .col is currently `display: flex` with no positioning — set it to
      // relative locally so the absolute badge anchors to the column box.
      col.style.position = "relative";
      col.appendChild(badge);
    });
    // Section badges — actual offsetHeight, plus estimator delta when available.
    document.querySelectorAll(".section[data-section]").forEach(sec => {
      const id = sec.getAttribute("data-section");
      const actual = sec.offsetHeight;
      // full_ratio = (y_content - y_section + h_content) / h_section
      // i.e. how far down the card the content bottom reaches, as a fraction
      // of the full card height (padding included). Complements `fillRatio`
      // (which uses the padding box) by accounting for the card's own padding —
      // useful for spotting cards where content fills the padded region but
      // the surrounding padding still makes the card look mostly empty.
      const secRect = sec.getBoundingClientRect();
      // secRect (and the child rects below) are post-transform SCREEN px, but
      // `actual` is offsetHeight (untransformed layout px). Recover the stage
      // scale so the screen-space content bottom can be converted back to
      // layout px before dividing by `actual` — otherwise fullRatio is off by
      // the scale factor in a scaled browser window. s===1 in the print view.
      const posterEl = document.querySelector(".poster");
      const sBox = posterEl ? posterEl.getBoundingClientRect() : null;
      const sc = (posterEl && posterEl.offsetWidth) ? sBox.width / posterEl.offsetWidth : 1;
      let cl = +Infinity, ct = +Infinity, cr = -Infinity, cb = -Infinity, hasContent = false;
      // Deep walk -- mirrors `check_poster.py slack` so the per-section badge's
      // fullRatio matches the staged-fill gate even when a descendant overflows
      // an intermediate wrapper (e.g. <figure> in .method-body in .section).
      const walk2 = (el) => {
        if (!el.classList) return;
        if (el.classList.contains("listen-btn")) return;
        if (el.classList.contains("dbg-badge"))  return;
        if (el.classList.contains("dbg-bbox"))   return;
        const rc = el.getBoundingClientRect();
        if (rc.width > 0 || rc.height > 0) {
          cl = Math.min(cl, rc.left);  ct = Math.min(ct, rc.top);
          cr = Math.max(cr, rc.right); cb = Math.max(cb, rc.bottom);
          hasContent = true;
        }
        Array.from(el.children).forEach(walk2);
      };
      Array.from(sec.children).forEach(walk2);
      const badge = document.createElement("div");
      badge.className = "dbg-badge dbg-section";
      let txt = `${id}  ${Math.round(actual)}px`;
      if (hasContent && actual > 0) {
        const fullRatio = ((cb - secRect.top) / sc) / actual;
        // Verdict label lives on the content bbox below — keep the
        // per-section badge compact.
        txt += `  ratio=${(fullRatio * 100).toFixed(1)}%`;
      }
      badge.textContent = txt;
      if (estimates && estimates[id] != null) {
        const est = estimates[id];
        const delta = Math.round(actual - est);
        const cls = delta >= 0 ? "dbg-delta-pos" : "dbg-delta-neg";
        const sign = delta >= 0 ? "+" : "";
        const span = document.createElement("span");
        span.className = cls;
        span.textContent = `est=${est} Δ${sign}${delta}`;
        badge.appendChild(document.createTextNode(" "));
        badge.appendChild(span);
      }
      sec.appendChild(badge);
    });
    stampBboxes();
  }

  window.__togglePosterDebug = function () {
    const enabling = !document.body.classList.contains("debug");
    document.body.classList.toggle("debug");
    if (enabling) {
      loadEstimates(() => stampBadges());
    } else {
      clearBadges();
    }
  };

  // Live-update on resize while debug is active so badge numbers stay honest.
  let raf = 0;
  window.addEventListener("resize", () => {
    if (!document.body.classList.contains("debug")) return;
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(stampBadges);
  });
})();
</script>
<script>
// Per-element debug layer (extends the `d`-key overlay) -- FANCY edition.
// On top of the per-section card/content/figure boxes, draw a rounded,
// TYPE-COLORED box around each DIRECT child element of every section (figure =
// violet, list = teal, text = blue, heading = dashed gray), label it with its
// tag + the whitespace GAP below it, and spotlight the one element that holds
// the section's slack with a glowing orange box + a "SLACK > GROW" pill -- the
// growable element the fill loop should target. Mirrors check_poster.py slack's
// per-element localization. Headings are never the slack element.
(function () {
  const S = document.createElement("style");
  S.textContent = `
